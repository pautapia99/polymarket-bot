# =====================================================
# MODO PAPER TRADING (recomendado para empezar)
# =====================================================
# Si PAPER_TRADING=true: lee precios reales de Polymarket pero
# simula los fills contra el orderbook real con un portafolio virtual.
# No requiere PRIVATE_KEY ni gas. Pon false solo cuando quieras operar de verdad.
PAPER_TRADING=true
INITIAL_CASH=1000

# Clave privada de la wallet Polygon (solo necesaria si PAPER_TRADING=false)
PRIVATE_KEY=

# Host CLOB (mainnet)
CLOB_HOST=https://clob.polymarket.com

# Chain ID: 137 = Polygon mainnet, 80002 = Amoy testnet
CHAIN_ID=137

# Tipo de firmante:
# 0 = EOA (wallet directa)
# 1 = Polymarket proxy (email/magic link)
# 2 = Browser wallet proxy (Metamask vía Polymarket UI)
SIGNATURE_TYPE=0

# Dirección del proxy/funder (déjalo vacío si SIGNATURE_TYPE=0)
FUNDER_ADDRESS=

# Token ID (ERC1155) del outcome que quieres operar.
# Lo encuentras en la URL del mercado o vía Gamma API.
TOKEN_ID=

# Estrategia: comprar si el precio <= BUY_BELOW, vender si >= SELL_ABOVE
BUY_BELOW=0.40
SELL_ABOVE=0.60

# Tamaño de cada orden en USDC
ORDER_SIZE_USDC=5

# Intervalo de polling en segundos
POLL_INTERVAL=30

# Modo simulación (true = no envía órdenes reales)
DRY_RUN=true
